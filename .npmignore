# .npmignore - Files to exclude from npm package

# Development files
.env.local
.env
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
test-files/
*.test.ts
*.spec.ts
coverage/

# Build artifacts (Next.js)
.next/
out/
build/

# Source files (we only publish dist/)
cli/
app/
components/
lib/
public/
styles/

# Config files
.eslintrc.json
.prettierrc
tsconfig.json
next.config.ts
tailwind.config.ts
postcss.config.mjs

# Git
.git/
.gitignore
.gitattributes

# Documentation (except README)
CLI-TESTING-GUIDE.md
docs/

# Misc
node_modules/
.DS_Store
*.md.backup
